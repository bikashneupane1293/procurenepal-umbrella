generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== TENANT (MULTI-TENANCY) ====================
model Tenant {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  panVat          String?
  address         String?
  contactEmail    String?
  contactPhone    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  subscriptions   Subscription[]
  featureFlags    TenantFeatureFlag[]
  certificates    Certificate[]
  tenders         Tender[]
  auditLogs       AuditLog[]
}

// ==================== USER & RBAC ====================
model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  phone        String?
  passwordHash String
  fullName     String
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  googleId     String?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  // ERP modules this user may open (empty = every module active in the workspace)
  modules      String[] @default([])
  // Task 5 - invite-by-link activation (no email service yet: the Owner copies the link)
  status            String    @default("ACTIVE") // ACTIVE | PENDING
  activationToken   String?   @unique
  activationExpires DateTime?
  // Task 5 - shown instead of the system role name on screen; the role itself still controls permissions
  customTitle       String?
  loginSessions     LoginSession[]

  @@index([tenantId])
}

enum Role {
  VIEWER
  SUPER_ADMIN
  OWNER
  DIRECTOR
  PROJECT_DIRECTOR
  PROCUREMENT_OFFICER
  ACCOUNTANT
  STORE_MANAGER
  SITE_ENGINEER
  SUPERVISOR
  HR_MANAGER
  VENDOR
}

// ==================== SUBSCRIPTION & FEATURE FLAGS ====================
model Subscription {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            Plan      @default(FREE)
  status          SubStatus @default(ACTIVE)
  startsAt        DateTime  @default(now())
  expiresAt       DateTime?
  paymentMethod   String?
  paymentRef      String?
  amountNPR       Decimal?  @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())

  @@index([tenantId])
}

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  TRIALING
}

model TenantFeatureFlag {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flagKey    String
  enabled    Boolean  @default(false)
  enabledAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  @@unique([tenantId, flagKey])
  @@index([tenantId])
}

// ==================== COMPANY & CERTIFICATES ====================
model Company {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  slug            String
  panVat          String?
  licenseClass    String?
  licenseExpiry   DateTime?
  address         String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  certificates    Certificate[]
  turnovers       AnnualTurnover[]
  bids            Bid[]
  banks           Bank[]
  guarantees      BankGuarantee[]
  projects        Project[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Certificate {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  certificateId      String   @unique
  projectName        String
  employerName       String?
  contractAmount     Decimal  @db.Decimal(15, 2)
  finalAmount        Decimal? @db.Decimal(15, 2)
  priceAdjustment    Decimal? @db.Decimal(15, 2) @default(0)
  fiscalYear         String
  projectType        String
  activities         String[] @default([])
  verificationStatus String   @default("unverified")
  completionStatus   String   @default("in_progress")
  jvShare            Decimal  @default(100) @db.Decimal(5, 2)
  pdfUrl             String?
  jvName             String?
  startDate          DateTime?
  completionDate     DateTime?
  keyActivities      Json?
  outstandingAmount  Decimal?  @db.Decimal(15, 2)
  isOpenBid          Boolean   @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@index([companyId])
  @@index([fiscalYear])
}

// ==================== TENDER & QUALIFICATION ====================
model Tender {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ifbNumber         String
  projectTitle      String
  procuringEntity   String?
  publicationDate   DateTime?
  deadlineDate      DateTime
  projectType       String?
  boqAmount         Decimal? @db.Decimal(15, 2)
  reqTurnover       Decimal? @db.Decimal(15, 2)
  reqActivity       String?
  reqProjectTypes   String[] @default([])
  reqMinProduction  Decimal? @db.Decimal(15, 2)
  status            String   @default("active")
  source            String   @default("manual")
  // Phase 6.4A — qualification engine v2
  contractPeriodMonths Int?
  reqBidCapacity    Decimal? @db.Decimal(15, 2)
  reqSimilarValue   Decimal? @db.Decimal(15, 2)
  reqSimilarCount   Int?
  similarDescription String?
  keyActivityReqs   Json?
  criteria          Json?
  isComplexWork     Boolean  @default(false)
  awardMethod       String?
  ruleSetId         String?
  notes             String?
  // Task 1 — bid information (values stated in the IFB)
  bidSecurityAmount Decimal? @db.Decimal(15, 2)
  bidValidityDays   Int?
  // Task 5 - auto-read bid document: a draft checklist for the user to verify, never an approval
  readinessChecklist Json?
  bids              Bid[]
  guarantees        BankGuarantee[]
  projects          Project[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([tenantId, ifbNumber])
  @@index([tenantId])
}

model QualificationResult {
  id                 String   @id @default(uuid())
  tenantId           String
  tenderId           String
  companyId          String
  result             String
  turnoverAact       Decimal? @db.Decimal(15, 2)
  turnoverRequired   Decimal? @db.Decimal(15, 2)
  keyActivityDetails Json?
  explanation        String?
  checks             Json?
  warnings           Json?
  ruleSetId          String?
  calculatedAt       DateTime @default(now())

  @@unique([tenderId, companyId])
  @@index([tenantId])
}

// Audited annual construction turnover per fiscal year (Phase 6.4A)
model AnnualTurnover {
  id         String   @id @default(uuid())
  tenantId   String
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear String
  amount     Decimal  @db.Decimal(15, 2)
  source     String   @default("audited")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([companyId, fiscalYear])
  @@index([tenantId])
}

// ==================== AUDIT LOGS ====================
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId      String?
  actionType  String
  entityType  String?
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  isAiAction  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ==================== BID INFORMATION (Task 1) ====================
// One bid record per tender per bidding company (the lead partner for a JV).
// Bid prices stay inside the workspace (tenantId) — never compared across customers.
model Bid {
  id                        String    @id @default(uuid())
  tenantId                  String
  tenderId                  String
  tender                    Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  companyId                 String
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bidderType                String    @default("SINGLE") // SINGLE | JV
  jvPartners                Json?     // [{ companyId, name, share, isLead }]
  decision                  String    @default("UNDECIDED") // UNDECIDED | BID | NO_BID
  decisionReason            String?
  status                    String    @default("PREPARING")
  statusHistory             Json?     // [{ status, at, byUserId }]
  bidAmount                 Decimal?  @db.Decimal(15, 2)
  submittedAt               DateTime?
  openingDate               DateTime?
  rank                      Int?
  bidSecurityAmount         Decimal?  @db.Decimal(15, 2)
  bidSecurityType           String?   // BANK_GUARANTEE | CASH_DEPOSIT | INSURANCE_BOND | DECLARATION
  bidSecurityBank           String?
  bidSecurityRef            String?
  bidSecurityIssueDate      DateTime?
  bidSecurityExpiry         DateTime?
  bidValidityExpiry         DateTime?
  intentionDate             DateTime?
  awardDate                 DateTime?
  contractSignDate          DateTime?
  contractAmount            Decimal?  @db.Decimal(15, 2)
  performanceSecurityAmount Decimal?  @db.Decimal(15, 2)
  performanceSecurityExpiry DateTime?
  checklist                 Json?     // [{ key, label, done, note }]
  notes                     String?
  guarantees                BankGuarantee[]
  project                   Project?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @default(now()) @updatedAt

  @@unique([tenderId, companyId])
  @@index([tenantId])
  @@index([tenantId, status])
}

// ==================== BANK SYSTEM (Task 2) ====================
// A bank (branch) with which a company holds accounts / a guarantee (non-fund) limit.
model Bank {
  id                   String    @id @default(uuid())
  tenantId             String
  companyId            String
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                 String
  branch               String?
  accountNumber        String?
  accountType          String?   // CURRENT | SAVINGS | OVERDRAFT | FIXED | OTHER
  bgLimit              Decimal?  @db.Decimal(15, 2) // guarantee (non-fund) limit
  defaultMarginPct     Decimal?  @db.Decimal(5, 2)
  defaultCommissionPct Decimal?  @db.Decimal(6, 3)
  commissionBasis      String?   // QUARTER | YEAR | FLAT
  contactPerson        String?
  phone                String?
  email                String?
  notes                String?
  isActive             Boolean   @default(true)
  guarantees           BankGuarantee[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  @@index([tenantId])
  @@index([companyId])
}

// Bid, performance, advance-payment, retention and other bank guarantees.
model BankGuarantee {
  id               String    @id @default(uuid())
  tenantId         String
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankId           String?
  bank             Bank?     @relation(fields: [bankId], references: [id], onDelete: SetNull)
  bankName         String
  branch           String?
  type             String    // BID_SECURITY | PERFORMANCE | ADVANCE_PAYMENT | RETENTION | CUSTOMS | OTHER
  guaranteeNo      String?
  bidId            String?
  bid              Bid?      @relation(fields: [bidId], references: [id], onDelete: SetNull)
  tenderId         String?
  tender           Tender?   @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  projectId        String?   // Task 3
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  beneficiary      String?
  purpose          String?
  amount           Decimal   @db.Decimal(15, 2)
  issueDate        DateTime?
  expiryDate       DateTime?
  claimExpiryDate  DateTime?
  marginPct        Decimal?  @db.Decimal(5, 2)
  marginAmount     Decimal?  @db.Decimal(15, 2)
  commissionPct    Decimal?  @db.Decimal(6, 3)
  commissionBasis  String?   // QUARTER | YEAR | FLAT
  commissionAmount Decimal?  @db.Decimal(15, 2)
  status           String    @default("ACTIVE") // REQUESTED | ACTIVE | RELEASED | EXPIRED | CLAIMED | CANCELLED
  releaseDate      DateTime?
  releaseRef       String?
  source           String    @default("MANUAL") // MANUAL | BID | IMPORT
  history          Json?     // [{ at, byUserId, action, changes }]
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@unique([bidId, type])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, expiryDate])
  @@index([bankId])
  @@index([projectId])
}

// ==================== PROJECT MANAGEMENT (Task 3) ====================
// A contract being executed — usually created from a won bid.
model Project {
  id                     String    @id @default(uuid())
  tenantId               String
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenderId               String?
  tender                 Tender?   @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  bidId                  String?   @unique
  bid                    Bid?      @relation(fields: [bidId], references: [id], onDelete: SetNull)
  code                   String
  name                   String
  client                 String?   // employer / procuring entity
  location               String?
  contractNo             String?
  projectType            String?
  contractAmount         Decimal?  @db.Decimal(15, 2) // excluding VAT
  contractSignDate       DateTime?
  startDate              DateTime? // work commencement
  contractPeriodMonths   Int?
  intendedCompletionDate DateTime?
  revisedCompletionDate  DateTime? // after extension of time
  actualCompletionDate   DateTime?
  defectLiabilityMonths  Int?
  advancePct             Decimal?  @db.Decimal(5, 2)
  retentionPct           Decimal?  @db.Decimal(5, 2)
  bidderType             String    @default("SINGLE") // SINGLE | JV
  jvPartners             Json?
  projectManager         String?
  clientEngineer         String?
  status                 String    @default("ONGOING") // PLANNED | MOBILIZING | ONGOING | SUSPENDED | COMPLETED | HANDED_OVER | CLOSED | TERMINATED
  source                 String    @default("MANUAL")  // MANUAL | BID | IMPORT
  statusHistory          Json?
  notes                  String?
  boqItems               BoqItem[]
  guarantees             BankGuarantee[]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenderId])
}

// One line of a project's Bill of Quantities (headings have no quantity / rate).
model BoqItem {
  id          String   @id @default(uuid())
  tenantId    String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sortOrder   Int
  itemNo      String?
  section     String?
  description String
  unit        String?
  quantity    Decimal? @db.Decimal(18, 3)
  rate        Decimal? @db.Decimal(15, 2)
  amount      Decimal? @db.Decimal(18, 2)
  isHeading   Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([tenantId])
}

// ==================== ERP ENGINE (Task 4) ====================
// One table for the registers and documents of Procurement & Inventory, Vehicle & Fleet,
// HR, Project Management (schedule, progress, petty contractors …) and Bank (loans, LC, assets).
// What each "entity" holds is defined in api/src/erp/erp.registry.ts.
model ErpRecord {
  id        String    @id @default(uuid())
  tenantId  String
  entity    String    // e.g. "proc.po"
  number    String?   // document number from the number series
  status    String?
  companyId String?
  projectId String?
  date      DateTime?
  total     Decimal?  @db.Decimal(18, 2)
  data      Json
  lines     Json?
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([tenantId, entity])
  @@index([tenantId, entity, status])
  @@index([tenantId, projectId])
}

// ==================== Task 5 ====================
model LoginSession {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt   DateTime  @default(now())
  logoutAt  DateTime?
  ip        String?
  userAgent String?

  @@index([tenantId, userId])
}

/// Public reference pages checked for changes (PPMO / NRB). Not tenant-scoped: public data only,
/// never bid prices. A manual "Check now" for now; automatic scheduling is a later decision.
model ExternalRef {
  id         String   @id @default(uuid())
  key        String   @unique
  label      String
  url        String
  fetchedAt  DateTime @default(now())
  contentHash String?
  excerpt    String?
  summary    Json?
  changed    Boolean  @default(false)
  error      String?
}
