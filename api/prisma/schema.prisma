generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== TENANT (MULTI-TENANCY) ====================
model Tenant {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  panVat          String?
  address         String?
  contactEmail    String?
  contactPhone    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  subscriptions   Subscription[]
  featureFlags    TenantFeatureFlag[]
  certificates    Certificate[]
  tenders         Tender[]
  auditLogs       AuditLog[]
}

// ==================== USER & RBAC ====================
model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  phone        String?
  passwordHash String
  fullName     String
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  googleId     String?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  // ERP modules this user may open (empty = every module active in the workspace)
  modules      String[] @default([])

  @@index([tenantId])
}

enum Role {
  VIEWER
  SUPER_ADMIN
  OWNER
  DIRECTOR
  PROJECT_DIRECTOR
  PROCUREMENT_OFFICER
  ACCOUNTANT
  STORE_MANAGER
  SITE_ENGINEER
  SUPERVISOR
  VENDOR
}

// ==================== SUBSCRIPTION & FEATURE FLAGS ====================
model Subscription {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            Plan      @default(FREE)
  status          SubStatus @default(ACTIVE)
  startsAt        DateTime  @default(now())
  expiresAt       DateTime?
  paymentMethod   String?
  paymentRef      String?
  amountNPR       Decimal?  @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())

  @@index([tenantId])
}

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  TRIALING
}

model TenantFeatureFlag {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flagKey    String
  enabled    Boolean  @default(false)
  enabledAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  @@unique([tenantId, flagKey])
  @@index([tenantId])
}

// ==================== COMPANY & CERTIFICATES ====================
model Company {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  slug            String
  panVat          String?
  licenseClass    String?
  licenseExpiry   DateTime?
  address         String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  certificates    Certificate[]
  turnovers       AnnualTurnover[]
  bids            Bid[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Certificate {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  certificateId      String   @unique
  projectName        String
  employerName       String?
  contractAmount     Decimal  @db.Decimal(15, 2)
  finalAmount        Decimal? @db.Decimal(15, 2)
  priceAdjustment    Decimal? @db.Decimal(15, 2) @default(0)
  fiscalYear         String
  projectType        String
  activities         String[] @default([])
  verificationStatus String   @default("unverified")
  completionStatus   String   @default("in_progress")
  jvShare            Decimal  @default(100) @db.Decimal(5, 2)
  pdfUrl             String?
  jvName             String?
  startDate          DateTime?
  completionDate     DateTime?
  keyActivities      Json?
  outstandingAmount  Decimal?  @db.Decimal(15, 2)
  isOpenBid          Boolean   @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@index([companyId])
  @@index([fiscalYear])
}

// ==================== TENDER & QUALIFICATION ====================
model Tender {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ifbNumber         String
  projectTitle      String
  procuringEntity   String?
  publicationDate   DateTime?
  deadlineDate      DateTime
  projectType       String?
  boqAmount         Decimal? @db.Decimal(15, 2)
  reqTurnover       Decimal? @db.Decimal(15, 2)
  reqActivity       String?
  reqProjectTypes   String[] @default([])
  reqMinProduction  Decimal? @db.Decimal(15, 2)
  status            String   @default("active")
  source            String   @default("manual")
  // Phase 6.4A — qualification engine v2
  contractPeriodMonths Int?
  reqBidCapacity    Decimal? @db.Decimal(15, 2)
  reqSimilarValue   Decimal? @db.Decimal(15, 2)
  reqSimilarCount   Int?
  similarDescription String?
  keyActivityReqs   Json?
  criteria          Json?
  isComplexWork     Boolean  @default(false)
  awardMethod       String?
  ruleSetId         String?
  notes             String?
  // Task 1 — bid information (values stated in the IFB)
  bidSecurityAmount Decimal? @db.Decimal(15, 2)
  bidValidityDays   Int?
  bids              Bid[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([tenantId, ifbNumber])
  @@index([tenantId])
}

model QualificationResult {
  id                 String   @id @default(uuid())
  tenantId           String
  tenderId           String
  companyId          String
  result             String
  turnoverAact       Decimal? @db.Decimal(15, 2)
  turnoverRequired   Decimal? @db.Decimal(15, 2)
  keyActivityDetails Json?
  explanation        String?
  checks             Json?
  warnings           Json?
  ruleSetId          String?
  calculatedAt       DateTime @default(now())

  @@unique([tenderId, companyId])
  @@index([tenantId])
}

// Audited annual construction turnover per fiscal year (Phase 6.4A)
model AnnualTurnover {
  id         String   @id @default(uuid())
  tenantId   String
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear String
  amount     Decimal  @db.Decimal(15, 2)
  source     String   @default("audited")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([companyId, fiscalYear])
  @@index([tenantId])
}

// ==================== AUDIT LOGS ====================
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId      String?
  actionType  String
  entityType  String?
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  isAiAction  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ==================== BID INFORMATION (Task 1) ====================
// One bid record per tender per bidding company (the lead partner for a JV).
// Bid prices stay inside the workspace (tenantId) — never compared across customers.
model Bid {
  id                        String    @id @default(uuid())
  tenantId                  String
  tenderId                  String
  tender                    Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  companyId                 String
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bidderType                String    @default("SINGLE") // SINGLE | JV
  jvPartners                Json?     // [{ companyId, name, share, isLead }]
  decision                  String    @default("UNDECIDED") // UNDECIDED | BID | NO_BID
  decisionReason            String?
  status                    String    @default("PREPARING")
  statusHistory             Json?     // [{ status, at, byUserId }]
  bidAmount                 Decimal?  @db.Decimal(15, 2)
  submittedAt               DateTime?
  openingDate               DateTime?
  rank                      Int?
  bidSecurityAmount         Decimal?  @db.Decimal(15, 2)
  bidSecurityType           String?   // BANK_GUARANTEE | CASH_DEPOSIT | INSURANCE_BOND | DECLARATION
  bidSecurityBank           String?
  bidSecurityRef            String?
  bidSecurityIssueDate      DateTime?
  bidSecurityExpiry         DateTime?
  bidValidityExpiry         DateTime?
  intentionDate             DateTime?
  awardDate                 DateTime?
  contractSignDate          DateTime?
  contractAmount            Decimal?  @db.Decimal(15, 2)
  performanceSecurityAmount Decimal?  @db.Decimal(15, 2)
  performanceSecurityExpiry DateTime?
  checklist                 Json?     // [{ key, label, done, note }]
  notes                     String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @default(now()) @updatedAt

  @@unique([tenderId, companyId])
  @@index([tenantId])
  @@index([tenantId, status])
}
